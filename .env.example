# Copie para .env e ajuste os valores. O arquivo .env nunca vai para o git.

# --- Banco (PostgreSQL + TimescaleDB) ---
POSTGRES_USER=plants
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plants
# Porta exposta no host (o container sempre usa 5432)
POSTGRES_PORT=5432

# --- Backend ---
# Usada ao rodar o backend fora do Docker. No docker-compose ela é montada
# automaticamente a partir das variáveis POSTGRES_* acima, apontando para o host "db".
DATABASE_URL=postgresql+psycopg://plants:change-me@127.0.0.1:5432/plants
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000

# Segredo para assinar os JWT (mínimo de 32 caracteres). Gere um valor próprio com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-um-segredo-gerado-com-token-urlsafe
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Testes ---
# Banco usado pelos testes de API (o nome precisa terminar em _test; as tabelas são recriadas).
# O pytest lê esta variável do ambiente, não deste arquivo.
TEST_DATABASE_URL=postgresql+psycopg://plants:change-me@127.0.0.1:5432/plants_test

# --- MQTT (Mosquitto) ---
MQTT_PORT=1883
